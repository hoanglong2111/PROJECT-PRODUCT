  tenant ||--o{ app_user : owns
  tenant ||--o{ app_role : owns
  tenant ||--o{ department : owns
  tenant ||--o{ item_category : owns
  tenant ||--o{ item : owns
  tenant ||--o{ supplier : owns
  tenant ||--o{ warehouse : owns
  tenant ||--o{ exchange_rate_daily : owns
  tenant ||--o{ sequence_generator : owns
  tenant ||--o{ tenant_config : owns
  tenant ||--o{ idempotency_key : owns

  app_user ||--o{ user_role : assigned
  app_role ||--o{ user_role : includes
  app_role ||--o{ role_permission : grants
  app_permission ||--o{ role_permission : maps
  department ||--o{ department : parent

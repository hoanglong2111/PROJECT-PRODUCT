erDiagram
  tenant {
    UUID id PK
    VARCHAR code UK
    VARCHAR name
    VARCHAR status
    JSONB config
    TIMESTAMPTZ created_at
  }

  app_user {
    UUID id PK
    UUID tenant_id FK
    VARCHAR email
    VARCHAR full_name
    UUID department_id FK
    VARCHAR status
    TIMESTAMPTZ last_login_at
  }

  app_role {
    UUID id PK
    UUID tenant_id FK
    VARCHAR code UK
    VARCHAR name
  }

  app_permission {
    VARCHAR code PK
    VARCHAR resource
    VARCHAR action
    TEXT description
  }

  user_role {
    UUID user_id PK
    UUID role_id PK
    TIMESTAMPTZ granted_at
    UUID granted_by FK
  }

  role_permission {
    UUID role_id PK
    VARCHAR permission_code PK
  }

  department {
    UUID id PK
    UUID tenant_id FK
    VARCHAR code
    VARCHAR name
    UUID parent_id FK
    UUID manager_id FK
  }

  item_category {
    UUID id PK
    UUID tenant_id FK
    VARCHAR code
    VARCHAR name
    UUID parent_id FK
  }

  item {
    UUID id PK
    UUID tenant_id FK
    VARCHAR item_code
    VARCHAR name
    VARCHAR unit_code FK
    VARCHAR item_type
    UUID category_id FK
    INT lead_time_days
    NUMERIC moq
    VARCHAR hs_code FK
    NUMERIC weight_kg
    NUMERIC volume_m3
    BOOLEAN is_active
  }

  supplier {
    UUID id PK
    UUID tenant_id FK
    VARCHAR supplier_code
    VARCHAR name
    VARCHAR supplier_type
    CHAR country
    VARCHAR currency_code FK
    VARCHAR incoterm_default FK
    INT lead_time_days
    BOOLEAN is_active
  }

  supplier_contact {
    UUID id PK
    UUID supplier_id FK
    VARCHAR name
    VARCHAR email
    VARCHAR phone
    BOOLEAN is_primary
  }

  warehouse {
    UUID id PK
    UUID tenant_id FK
    VARCHAR code
    VARCHAR name
    TEXT address
    BOOLEAN is_active
  }

  port {
    VARCHAR code PK
    VARCHAR name
    CHAR country
    VARCHAR port_type
  }

  carrier {
    UUID id PK
    VARCHAR code UK
    VARCHAR name
    VARCHAR carrier_type
  }

  currency {
    CHAR code PK
    VARCHAR name
    VARCHAR symbol
    INT decimal_places
    BOOLEAN is_active
  }

  exchange_rate_daily {
    UUID id PK
    UUID tenant_id FK
    CHAR from_currency FK
    CHAR to_currency FK
    DATE rate_date
    NUMERIC rate
    VARCHAR source
  }

  incoterm {
    VARCHAR code PK
    VARCHAR name
    TEXT description
    VARCHAR version
  }

  unit_of_measure {
    VARCHAR code PK
    VARCHAR name
    VARCHAR unit_type
    VARCHAR base_unit_code FK
    NUMERIC conversion_factor
  }

  hs_code {
    VARCHAR code PK
    TEXT description
    NUMERIC default_tax_rate
  }

  sequence_generator {
    UUID tenant_id PK
    VARCHAR sequence_type PK
    INT year PK
    BIGINT current_value
    VARCHAR prefix
    INT padding
  }

  tenant_config {
    UUID tenant_id PK
    VARCHAR config_key PK
    JSONB config_value
    UUID updated_by FK
    TIMESTAMPTZ updated_at
  }

  idempotency_key {
    VARCHAR key PK
    UUID tenant_id FK
    UUID user_id FK
    CHAR request_hash
    INT response_status
    JSONB response_body
    TIMESTAMPTZ expires_at
  }

  purchase_request {
    UUID id PK
    UUID tenant_id FK
    VARCHAR pr_no UK
    VARCHAR title
    UUID requester_id FK
    UUID department_id FK
    VARCHAR priority
    VARCHAR status
    DATE required_date
    NUMERIC total_amount
    CHAR currency_code FK
    TIMESTAMPTZ submitted_at
    TIMESTAMPTZ approved_at
  }

  purchase_request_line {
    UUID id PK
    UUID tenant_id FK
    UUID purchase_request_id FK
    UUID item_id FK
    INT line_no
    NUMERIC qty_requested
    NUMERIC qty_converted
    VARCHAR unit_code FK
    NUMERIC target_price
    CHAR currency_code FK
    DATE required_date
    UUID preferred_supplier_id FK
  }

  purchase_request_revision {
    UUID id PK
    UUID purchase_request_id FK
    INT revision_no
    JSONB header_snapshot
    JSONB lines_snapshot
    UUID revised_by FK
    TIMESTAMPTZ revised_at
  }

  approval_matrix_config {
    UUID id PK
    UUID tenant_id FK
    VARCHAR applies_to
    UUID department_id FK
    NUMERIC min_amount_vnd
    NUMERIC max_amount_vnd
    JSONB required_roles
    INT escalation_timeout_hours
    BOOLEAN is_active
  }

  approval_instance {
    UUID id PK
    UUID tenant_id FK
    VARCHAR entity_type
    UUID entity_id
    UUID matrix_config_id FK
    VARCHAR status
    TIMESTAMPTZ started_at
    TIMESTAMPTZ completed_at
  }

  approval_step {
    UUID id PK
    UUID instance_id FK
    INT step_order
    UUID approver_id FK
    VARCHAR approver_role
    VARCHAR status
    TIMESTAMPTZ due_at
    TIMESTAMPTZ decision_at
    UUID escalated_to FK
  }

  purchase_order {
    UUID id PK
    UUID tenant_id FK
    VARCHAR po_no UK
    INT revision
    UUID supplier_id FK
    VARCHAR po_type
    VARCHAR incoterm_code FK
    VARCHAR payment_term
    CHAR currency_code FK
    NUMERIC exchange_rate
    VARCHAR status
    DATE expected_etd
    DATE expected_eta
    TIMESTAMPTZ confirmed_by_supplier_at
    NUMERIC tolerance_over_pct
    NUMERIC tolerance_under_pct
  }

  purchase_order_line {
    UUID id PK
    UUID tenant_id FK
    UUID purchase_order_id FK
    UUID purchase_request_line_id FK
    UUID item_id FK
    INT line_no
    VARCHAR status
    NUMERIC qty_ordered
    NUMERIC qty_shipped
    NUMERIC qty_received
    NUMERIC unit_price
    NUMERIC landed_cost_alloc
    DATE expected_eta_line
  }

  purchase_order_revision {
    UUID id PK
    UUID purchase_order_id FK
    INT revision_no
    JSONB header_snapshot
    JSONB lines_snapshot
    JSONB diff_from_previous
    UUID revised_by FK
    TIMESTAMPTZ revised_at
    TIMESTAMPTZ supplier_reconfirmed_at
  }

  shipment {
    UUID id PK
    UUID tenant_id FK
    VARCHAR shipment_no UK
    VARCHAR mode
    UUID forwarder_id FK
    UUID carrier_id FK
    VARCHAR vessel_flight
    VARCHAR bl_awb_no
    VARCHAR pol_code FK
    VARCHAR pod_code FK
    DATE etd
    DATE eta
    DATE atd
    DATE ata
    VARCHAR status
    VARCHAR customs_stream
  }

  shipment_container {
    UUID id PK
    UUID shipment_id FK
    VARCHAR container_no
    VARCHAR seal_no
    VARCHAR container_type
    NUMERIC gross_weight_kg
  }

  shipment_line {
    UUID id PK
    UUID tenant_id FK
    UUID shipment_id FK
    UUID purchase_order_line_id FK
    NUMERIC qty_shipped
    VARCHAR lot_no
  }

  shipment_milestone {
    UUID id PK
    UUID tenant_id FK
    UUID shipment_id FK
    SMALLINT sequence_no
    VARCHAR milestone_code
    DATE planned_date
    DATE actual_date
    UUID recorded_by FK
    VARCHAR source
  }

  shipment_cost {
    UUID id PK
    UUID tenant_id FK
    UUID shipment_id FK
    VARCHAR cost_type
    NUMERIC amount
    CHAR currency_code FK
    NUMERIC exchange_rate
    VARCHAR alloc_method
    VARCHAR invoice_ref
  }

  po_task_template {
    UUID id PK
    UUID tenant_id FK
    VARCHAR po_type
    VARCHAR po_stage
    VARCHAR task_name
    VARCHAR default_assignee_role
    INT sla_hours
    VARCHAR linked_milestone
    BOOLEAN is_active
    INT sort_order
  }

  po_stage_task {
    UUID id PK
    UUID tenant_id FK
    UUID purchase_order_id FK
    VARCHAR po_stage
    VARCHAR task_name
    UUID task_template_id FK
    UUID assignee_id FK
    UUID assigned_by FK
    VARCHAR status
    TIMESTAMPTZ due_date
    TIMESTAMPTZ completed_at
    UUID completed_by FK
    VARCHAR linked_shipment_milestone
  }

  task_audit_log {
    BIGINT id PK
    UUID task_id FK
    VARCHAR old_status
    VARCHAR new_status
    UUID changed_by FK
    TIMESTAMPTZ changed_at
    TEXT note
  }

  file_storage {
    UUID id PK
    UUID tenant_id FK
    VARCHAR storage_key
    VARCHAR file_name
    VARCHAR mime_type
    BIGINT file_size_bytes
    CHAR checksum_sha256
    UUID uploaded_by FK
    TIMESTAMPTZ uploaded_at
  }

  document_attachment {
    UUID id PK
    UUID tenant_id FK
    UUID file_id FK
    VARCHAR entity_type
    UUID entity_id
    VARCHAR doc_type
    VARCHAR milestone_code
  }

  sla_config {
    UUID id PK
    UUID tenant_id FK
    VARCHAR stage_code
    VARCHAR checkpoint_name
    VARCHAR applies_to
    VARCHAR trigger_event
    INT sla_value
    VARCHAR sla_unit
    VARCHAR sla_direction
    BOOLEAN is_active
  }

  sla_event {
    UUID id PK
    UUID tenant_id FK
    UUID sla_config_id FK
    VARCHAR entity_type
    UUID entity_id
    UUID shipment_id FK
    VARCHAR stage_code
    TIMESTAMPTZ due_at
    TIMESTAMPTZ resolved_at
    VARCHAR status
  }

  notification_template {
    VARCHAR code PK
    UUID tenant_id FK
    VARCHAR channel
    TEXT subject_template
    TEXT body_template
    VARCHAR locale
  }

  notification {
    UUID id PK
    UUID tenant_id FK
    UUID recipient_id FK
    VARCHAR channel
    VARCHAR template_code FK
    VARCHAR entity_type
    UUID entity_id
    JSONB payload
    VARCHAR status
    TIMESTAMPTZ sent_at
    TIMESTAMPTZ read_at
  }

  notification_preference {
    UUID user_id PK
    VARCHAR event_code PK
    VARCHAR channel
    BOOLEAN is_enabled
  }

  audit_log {
    BIGINT id PK
    UUID tenant_id FK
    VARCHAR entity_type
    UUID entity_id
    VARCHAR action
    JSONB before_data
    JSONB after_data
    UUID user_id FK
    UUID correlation_id
    TIMESTAMPTZ created_at
  }

  state_transition_log {
    BIGINT id PK
    UUID tenant_id FK
    VARCHAR entity_type
    UUID entity_id
    VARCHAR from_state
    VARCHAR to_state
    UUID changed_by FK
    TIMESTAMPTZ changed_at
  }

  outbox_event {
    UUID id PK
    UUID tenant_id FK
    VARCHAR aggregate_type
    UUID aggregate_id
    VARCHAR event_type
    JSONB payload
    VARCHAR status

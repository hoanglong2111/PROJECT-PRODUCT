{
  "version": 1,
  "purpose": "Coordinate IDE and development agents for KBFE repository work.",
  "agents": [
    {
      "id": "codex",
      "label": "Codex",
      "role": "primary_development_coordinator",
      "surfaces": ["Codex CLI", "Codex IDE"],
      "responsibilities": [
        "read project context and focused skills",
        "plan scoped implementation work",
        "edit repository files inside approved write scope",
        "run verification checks",
        "write per-question logs",
        "summarize changed files and residual risk"
      ],
      "boundaries": [
        "do not deploy or run destructive commands without explicit approval",
        "do not log secrets or raw environment values",
        "do not revert unrelated user changes"
      ]
    },
    {
      "id": "claude",
      "label": "Claude",
      "role": "optional_review_or_design_partner",
      "surfaces": ["Claude IDE", "Claude chat"],
      "responsibilities": [
        "review plans and diffs",
        "challenge assumptions",
        "help simplify complex changes",
        "draft documentation or acceptance criteria"
      ],
      "boundaries": [
        "follow AGENTS.md when operating in this repository",
        "do not replace project source-of-truth docs"
      ]
    },
    {
      "id": "cursor",
      "label": "Cursor",
      "role": "optional_editor_assistant",
      "surfaces": ["Cursor IDE"],
      "responsibilities": [
        "assist local code navigation",
        "apply small scoped edits",
        "surface inline implementation context"
      ],
      "boundaries": [
        "keep edits traceable to the active user request",
        "run or request the same verification checks as Codex"
      ]
    },
    {
      "id": "mcp",
      "label": "MCP Tools",
      "role": "automation_and_readiness_layer",
      "surfaces": ["server/mcp/deployServer.ts"],
      "responsibilities": [
        "inspect repository readiness",
        "inspect environment variable names without revealing values",
        "inspect database schema and counts",
        "check runtime health",
        "trigger guarded deploy or migration flows only when confirmed"
      ],
      "boundaries": [
        "write/deploy tools require explicit confirmation",
        "read tools must redact secrets"
      ]
    },
    {
      "id": "product_ai_harness",
      "label": "GD1 Product AI Harness",
      "role": "read_only_product_context_provider",
      "surfaces": ["server/ai", "POST /api/ai/harness", "run_gd1_harness"],
      "responsibilities": [
        "summarize GD1 risks",
        "draft operational recommendations",
        "draft PO-stage tasks",
        "provide model route and metrics"
      ],
      "boundaries": [
        "does not coordinate repository edits",
        "does not write operational data"
      ]
    }
  ]
}

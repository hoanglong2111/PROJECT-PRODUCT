{
  "version": 1,
  "contextPacks": [
    {
      "id": "frontend_feature",
      "description": "React/Mantine feature screens, shared frontend components, routes, and frontend API wiring.",
      "triggerWhen": [
        "React feature page",
        "shared frontend component",
        "frontend API wiring",
        "route or deep-link behavior"
      ],
      "readFirst": [
        ".agents/agent-config.json",
        ".agents/memory.md",
        "AGENTS.md",
        "docs/skills/frontend/SKILL.md"
      ],
      "optionalWhenRelevant": [
        "docs/context/PROJECT_CONTEXT.md",
        "docs/context/OPERATING_MODEL.md",
        "docs/skills/ui-ux/SKILL.md",
        "docs/skills/ui-ux-debug/SKILL.md"
      ],
      "scanHints": [
        "frontend/src/features",
        "frontend/src/shared/api",
        "frontend/src/shared/components",
        "frontend/src/app/routes.tsx"
      ]
    },

    {
      "id": "workflow_docs",
      "description": "Business workflow, SLA, actor/state mapping, module docs, and acceptance criteria.",
      "triggerWhen": [
        "business workflow",
        "SLA",
        "actor or state rules",
        "acceptance criteria"
      ],
      "readFirst": [
        ".agents/agent-config.json",
        ".agents/memory.md",
        "AGENTS.md",
        "docs/context/PROJECT_CONTEXT.md",
        "docs/context/OPERATING_MODEL.md",
        "docs/skills/workflow/SKILL.md"
      ],
      "optionalWhenRelevant": [
        "docs/modules/procurement",
        "docs/modules/shipments",
        "docs/modules/tasks"
      ],
      "scanHints": [
        "docs/context",
        "docs/modules",
        "frontend/src/features/workflow"
      ]
    },
    {
      "id": "testing_qa",
      "description": "Test strategy, QA checklists, regression coverage, build validation, and release readiness checks.",
      "triggerWhen": [
        "test strategy",
        "QA checklist",
        "regression coverage",
        "build validation",
        "release readiness",
        "adding tests"
      ],
      "readFirst": [
        ".agents/agent-config.json",
        ".agents/memory.md",
        "AGENTS.md",
        "docs/skills/testing-qa/SKILL.md"
      ],
      "optionalWhenRelevant": [
        "docs/context/PROJECT_CONTEXT.md",
        "docs/context/OPERATING_MODEL.md",
        "docs/skills/frontend/SKILL.md"
      ],
      "scanHints": [
        "frontend/src/**/*.test.*",
        "docs/skills/testing-qa"
      ]
    },
    {
      "id": "i18n_translation",
      "description": "i18n translation workflow, adding new language keys, auditing hardcoded strings, and maintaining EN/VI dictionaries.",
      "triggerWhen": [
        "i18n",
        "translation",
        "hardcoded string",
        "language key",
        "add translation",
        "missing translation"
      ],
      "readFirst": [
        ".agents/agent-config.json",
        ".agents/memory.md",
        "AGENTS.md",
        "docs/skills/i18n-translation/SKILL.md"
      ],
      "optionalWhenRelevant": [
        "docs/context/PROJECT_CONTEXT.md",
        "docs/skills/frontend/SKILL.md",
        "docs/skills/ui-ux/SKILL.md"
      ],
      "scanHints": [
        "frontend/src/shared/i18n",
        "frontend/src/features",
        "frontend/src/shared/components"
      ]
    },
    {
      "id": "mcp_dev_harness",
      "description": "MCP, readiness checks, deploy automation, product AI harness, and development harness coordination.",
      "triggerWhen": [
        "development agent harness",
        "MCP readiness",
        "deploy automation",
        "agent context loading or memory rules"
      ],
      "readFirst": [
        ".agents/agent-config.json",
        ".agents/memory.md",
        "AGENTS.md",
        ".agents/harness/README.md",
        "docs/skills/mcp/SKILL.md",
        "docs/modules/platform/dev-ai-harness.md"
      ],
      "optionalWhenRelevant": [
        "docs/modules/platform/ai-harness.md",
        "docs/future/mcp-ops/deployment-mcp-and-db-plan.md"
      ],
      "scanHints": [
        ".agents",
        "docs/modules/platform"
      ]
    }
  ]
}
